{
  "expo": {
    "name": "Patchlane · Puncture Demo",
    "slug": "patchlane-puncture-demo-v3",
    "version": "3.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "description": "Local-only motorcycle puncture help prototype with fictional sample listings.",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kominman.patchlane",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Patchlane to check your location once in the foreground after you tap to look for nearby help."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a6398fe5-6703-4aeb-b926-2f6448eed963"
      }
    },
    "owner": "kominman"
  }
}
